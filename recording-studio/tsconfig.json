{
  "compilerOptions": {
    "target": "es2020", "lib": ["dom", "dom.iterable", "es2020"],
    "module": "esnext", "moduleResolution": "node", "jsx": "react-jsx",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "allowJs": true, "noEmit": true,
    "types": ["vite/client", "node", "vitest/globals"]
  },
  "include": ["src", "tests/*.ts", "tests/*.tsx", "shared"]
}

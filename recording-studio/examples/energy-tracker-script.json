{
  "title": "UNDP Sustainable Energy Tracker recording walkthrough",
  "description": "Edit this file to change the screen-recording walkthrough. Targets map to data-walkthrough-target attributes in the app. Supported actions: scroll, move, hover, click, type, circle, tooltip, wait.",
  "defaults": {
    "moveDurationMs": 780,
    "scrollDurationMs": 950,
    "pauseMs": 1250,
    "circleRadius": 34,
    "circleDurationMs": 2400
  },
  "start": {
    "x": 90,
    "y": 120
  },
  "scenes": [
    {
      "id": "welcome",
      "caption": "Welcome to the UNDP Sustainable Energy Tracker, a digital tool that monitors collective progress on sustainable, affordable and reliable energy.",
      "actions": [
        { "type": "scroll", "target": "hero", "block": "start", "durationMs": 850 },
        { "type": "circle", "target": "hero-title", "loops": 1 },
        { "type": "wait", "durationMs": 1300 }
      ]
    },
    {
      "id": "access-and-productive-use",
      "caption": "The tracker goes beyond new energy access to show productive uses of energy, including health services, water, agriculture, transport and clean cooking.",
      "actions": [
        { "type": "scroll", "target": "energy-for-development", "block": "center" },
        { "type": "circle", "target": "energy-for-development-title", "loops": 1 },
        { "type": "scroll", "target": "dashboard-title", "block": "start", "offsetY": -40 },
        { "type": "circle", "target": "beneficiary-categories", "loops": 1 },
        { "type": "hover", "target": "subcategory-selector", "durationMs": 850 }
      ]
    },
    {
      "id": "targets-and-policy",
      "caption": "The data also tracks renewable installed capacity targets and support across energy policy dimensions.",
      "actions": [
        { "type": "circle", "target": "kpi-cards", "loops": 1 },
        { "type": "circle", "target": "portfolio-overview", "loops": 1 },
        { "type": "circle", "target": "map-indicator", "loops": 1 }
      ]
    },
    {
      "id": "filters",
      "caption": "Projects can be filtered by region, funding source and gender markers, either directly or through the AI tool across seven languages.",
      "actions": [
        { "type": "circle", "target": "funding-filter", "loops": 1 },
        { "type": "circle", "target": "region-filter", "loops": 1 },
        { "type": "circle", "target": "gender-filter", "loops": 1 },
        { "type": "circle", "target": "dashboard-language", "loops": 1 }
      ]
    },
    {
      "id": "ai-query",
      "caption": "For example, search for e-mobility projects across the Asia-Pacific region and the dashboard updates with automated summaries.",
      "actions": [
        { "type": "scroll", "target": "ai-query-panel", "block": "center" },
        { "type": "click", "target": "ai-query-input" },
        {
          "type": "type",
          "target": "ai-query-input",
          "text": "show e-mobility projects in the Asia-Pacific region",
          "clear": true,
          "durationMs": 2600
        },
        { "type": "click", "target": "ai-query-submit", "pauseMs": 2200 },
        { "type": "circle", "target": "portfolio-overview", "loops": 1 },
        { "type": "circle", "target": "map", "loops": 1 }
      ]
    },
    {
      "id": "exports-and-projects",
      "caption": "The map can be exported with the chosen indicator, and the filtered dataset can be downloaded for reporting.",
      "actions": [
        { "type": "circle", "target": "map-export", "loops": 1 },
        { "type": "scroll", "target": "explore-projects", "block": "start", "offsetY": -40 },
        { "type": "circle", "target": "workbook-export", "loops": 1 },
        { "type": "circle", "target": "project-overview-card", "loops": 1 },
        { "type": "circle", "target": "project-table", "loops": 1 }
      ]
    },
    {
      "id": "feedback",
      "caption": "Updates can be submitted through original input sheets or commented directly in the platform.",
      "actions": [
        { "type": "scroll", "target": "feedback-form", "block": "center" },
        { "type": "circle", "target": "feedback-form", "loops": 1 },
        { "type": "wait", "durationMs": 1400 }
      ]
    }
  ]
}
